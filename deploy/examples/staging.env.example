# Paths and image name only. Credentials belong in the private JSON/key files.
MDDIFF_IMAGE=mddiff:staging
MDDIFF_DATA_DIR=/srv/mddiff/data
MDDIFF_SECRETS_DIR=/srv/mddiff/secrets
# Optional privacy overlay; keep this outside document checkpoint restoration.
MDDIFF_PRIVACY_DIR=/srv/mddiff/privacy
# Temporary operator checkpoint; private, writable, and separate from the journal.
MDDIFF_CHECKPOINT_DIR=/srv/mddiff/checkpoint
